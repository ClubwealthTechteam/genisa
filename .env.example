# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables. Never commit real values.

# --- Sign-in (access codes, like the CW AI Task Hub) ---
# Long random text that signs the sign-in cookie. At least 32 characters.
# Make one with: openssl rand -hex 32
SESSION_SECRET=
# Each person's own access code, as JSON. Ids are in src/config/people.ts.
# Codes must be at least 8 characters.
GENISA_ACCESS_CODES={"miguel":"replace-me","ali":"replace-me"}

# --- Database (Neon free plan, added from Vercel > Storage) ---
# Vercel fills both of these in when the Neon database is connected to the project.
# DATABASE_URL is the pooled connection the app uses.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED is the direct connection, used only by npm run db:migrate.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
