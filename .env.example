# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables. Never commit real values.

# The app's own address, used in sign-in emails. No trailing slash.
SITE_URL=http://localhost:3000

# Supabase > Project Settings > API. The publishable (anon) key is safe for the
# server to use for sign-in; it cannot read GenISA's tables.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase > Connect > Transaction pooler (port 6543). Used by the app.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Supabase > Connect > Direct connection (port 5432). Used only by npm run db:migrate.
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# The only people who can sign in, comma separated.
ALLOWED_EMAILS=miguel@example.com,ali@example.com
